      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(arbiter_l8_layer_latency_milliseconds_bucket{exported_job=\"arbiter-l8\"}[5m])) by (le, layer))",
